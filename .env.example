# Any OpenAI-compatible endpoint works. Default: OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# all-MiniLM-L6-v2 (tiny, CPU) | BAAI/bge-small-en-v1.5 (stronger) | hash (offline, tests only)
EMBED_MODEL=all-MiniLM-L6-v2

CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K=5
# Below this cosine similarity the app answers "I don't know" without calling the LLM.
MIN_SCORE=0.25
